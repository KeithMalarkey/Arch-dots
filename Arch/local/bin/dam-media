#!/bin/sh
# ~/.local/bin/dam-media
# 点击 dam 的媒体模块时调用：播放/暂停、音量、静音。

choice=$(printf '%s\n' \
	"Play/Pause" \
	"Volume +5%" \
	"Volume -5%" \
	"Mute" \
	| fuzzel --dmenu -p "Media")

[ -n "$choice" ] || exit 0

case "$choice" in
	"Play/Pause") playerctl play-pause ;;
	"Volume +5%") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ ;;
	"Volume -5%") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
	"Mute")       wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
esac
