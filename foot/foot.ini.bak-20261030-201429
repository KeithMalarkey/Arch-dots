# -*- conf -*-
# ~/.config/foot/foot.ini
#
# 字体：Hack Nerd Font（图标齐全，12pt）
# 行高：26px —— 中文走 fontconfig 回退到 Noto Sans CJK，
#       它的 hhea 行高是 1.448em（12pt ≈ 16px em → 需要 ≈23.2px），
#       行高不够的话汉字顶部会被裁掉，所以这里留到 26px。
# 配色：solarized base03，和 river / niri 统一。

app-id=foot
title=foot
locked-title=no

# ---------------- 字体 ----------------
font=Hack Nerd Font:size=12
line-height=24px

# ---------------- 窗口 ----------------
initial-color-theme=dark
initial-window-size-chars=100x30
pad=8x8 center-when-maximized-and-fullscreen
resize-by-cells=yes
resize-keep-grid=yes
bold-text-in-bright=no
# 鼠标选中的内容直接进剪贴板（river 里 cliphist 才能截获到）
selection-target=clipboard
word-delimiters=,│`|:"'()[]{}<>

[environment]
# name=value

[security]
# 允许终端程序读写剪贴板（ OSC 52 ）
osc52=enabled

[bell]
system=yes
urgent=no
notify=yes
visual=no

[desktop-notifications]
# close= 命令为空时用默认行为

[scrollback]
lines=10000
multiplier=3.0
indicator-position=relative

[url]
launch=xdg-open ${url}
style=dotted
osc8-underline=url-mode

[cursor]
style=beam
blink=no
beam-thickness=1.5

[mouse]
hide-when-typing=yes
alternate-scroll-mode=yes

[touch]
long-press-delay=400

# ---------------- 配色（黑底磷光绿，CRT hacker 风）----------------
# ANSI 十六色保持 foot 自带默认（红黄蓝照常显示，便于识别报错），
# 这里只改背景 / 前景 / 光标。
[colors-dark]
alpha=1.0
alpha-mode=default
background=030a03
foreground=33ff66
cursor=ffffff 33ff66
flash=33ff66
flash-alpha=0.4

[key-bindings]
show-urls-launch=Control+Shift+o
