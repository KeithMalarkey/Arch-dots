# -*- conf -*-
# ~/.config/foot/foot.ini
#
# 字体：Hack Nerd Font（图标齐全，12pt）
# 行高：26px —— 中文走 fontconfig 回退到 Noto Sans CJK，
#       它的 hhea 行高是 1.448em（12pt ≈ 16px em → 需要 ≈23.2px），
#       行高不够的话汉字顶部会被裁掉，所以这里留到 26px。
# 配色：solarized base03，和 river / niri 统一。

app-id=foot
title=foot
locked-title=no

# ---------------- 字体 ----------------
font=Hack Nerd Font:size=12
font-bold=Hack Nerd Font:style=Bold:size=12
font-italic=Hack Nerd Font:style=Italic:size=12
font-bold-italic=Hack Nerd Font:style=Bold Italic:size=12
line-height=26px
letter-spacing=0
box-drawings-uses-font-glyphs=no

# ---------------- 窗口 ----------------
initial-color-theme=dark
initial-window-size-chars=100x30
pad=8x8 center-when-maximized-and-fullscreen
resize-by-cells=yes
resize-keep-grid=yes
bold-text-in-bright=no
# 鼠标选中的内容直接进剪贴板（river 里 cliphist 才能截获到）
selection-target=clipboard
word-delimiters=,│`|:"'()[]{}<>

[environment]
# name=value

[security]
# 允许终端程序读写剪贴板（ OSC 52 ）
osc52=enabled

[bell]
system=yes
urgent=no
notify=yes
visual=no

[desktop-notifications]
# close= 命令为空时用默认行为

[scrollback]
lines=10000
multiplier=3.0
indicator-position=relative

[url]
launch=xdg-open ${url}
style=dotted
osc8-underline=url-mode

[cursor]
style=beam
blink=no
beam-thickness=1.5

[mouse]
hide-when-typing=yes
alternate-scroll-mode=yes

[touch]
long-press-delay=400

# ---------------- 配色（solarized dark）----------------
[colors-dark]
alpha=1.0
alpha-mode=default
background=002b36
foreground=93a1a1
cursor=93a1a1 268bd2
flash=268bd2
flash-alpha=0.4

## Normal/regular colors (0-7)
regular0=002b36
regular1=dc322f
regular2=859900
regular3=b58900
regular4=268bd2
regular5=d33682
regular6=2aa198
regular7=eee8d5

## Bright colors (8-15)
bright0=586e75
bright1=cb4b16
bright2=93a1a1
bright3=657b83
bright4=839496
bright5=6c71c4
bright6=94d2bd
bright7=fdf6e3

[key-bindings]
show-urls-launch=Control+Shift+o
