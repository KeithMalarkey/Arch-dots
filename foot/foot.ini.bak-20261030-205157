# -*- conf -*-
# ~/.config/foot/foot.ini
#
# 字体：Hack Nerd Font（图标齐全，12pt）
# 行高：26px —— 中文走 fontconfig 回退到 Noto Sans CJK，
#       它的 hhea 行高是 1.448em（12pt ≈ 16px em → 需要 ≈23.2px），
#       行高不够的话汉字顶部会被裁掉，所以这里留到 26px。
# 配色：solarized base03，和 river / niri 统一。

app-id=foot
title=foot
locked-title=no

# ---------------- 字体 ----------------
font=Hack Nerd Font:size=12
line-height=24px

# ---------------- 窗口 ----------------
initial-color-theme=dark
initial-window-size-chars=100x30
pad=8x8 center-when-maximized-and-fullscreen
resize-by-cells=yes
resize-keep-grid=yes
bold-text-in-bright=no
# 鼠标选中的内容直接进剪贴板（river 里 cliphist 才能截获到）
selection-target=clipboard
word-delimiters=,│`|:"'()[]{}<>

[environment]
# name=value

[security]
# 允许终端程序读写剪贴板（ OSC 52 ）
osc52=enabled

[bell]
system=yes
urgent=no
notify=yes
visual=no

[desktop-notifications]
# close= 命令为空时用默认行为

[scrollback]
lines=10000
multiplier=3.0
indicator-position=relative

[url]
launch=xdg-open ${url}
style=dotted
osc8-underline=url-mode

[cursor]
style=beam
blink=no
beam-thickness=1.5

[mouse]
hide-when-typing=yes
alternate-scroll-mode=yes

[touch]
long-press-delay=400

# ---------------- 配色（vault 主题：琥珀磷光 + Matrix 绿）----------------
# 与 nvim 插件 mrpbennett/vault 一致，
# 十六色直接照搬仓库里的 extras/ghostty/vault。
[colors-dark]
alpha=1.0
alpha-mode=default
background=0a0a00
foreground=c8b400
cursor=0a0a00 c8b400
flash=c8b400
flash-alpha=0.4

## Normal/regular colors (0-7)
regular0=0a0a00
regular1=cc4400
regular2=00ff41
regular3=c8b400
regular4=5a5200
regular5=5a5200
regular6=7aff00
regular7=c8b400

## Bright colors (8-15)
bright0=2a2800
bright1=cc4400
bright2=7aff00
bright3=c8b400
bright4=5a5200
bright5=5a5200
bright6=00ff41
bright7=e8d400

[key-bindings]
show-urls-launch=Control+Shift+o
